# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB connection string)
MONGODB_URI=mongodb://localhost:27017/interview_prep_kit

# Authentication
JWT_SECRET=super_secret_interview_prep_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# LLM Providers (Generous Free Tiers & Fallbacks)
# Primary (Free Tier): Google Gemini API (Get free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Secondary (Optional Fallback): OpenAI API (If you have an OpenAI key)
OPENAI_API_KEY=your_openai_api_key_here

# Tertiary (Free Tier Fallback): Groq API (Get free key at https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
